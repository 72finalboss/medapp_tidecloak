{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "name": "MediCare Modern Healthcare Design System",
    "version": "2.0.0",
    "framework": "React 19 + TypeScript + Tailwind CSS v4",
    "description": "Minimalist, compassionate, accessible healthcare design tokens with light/dark mode and TideCloak clinical governance."
  },
  "breakpoints": {
    "xs": { "value": "320px", "description": "Compact mobile handsets (single-column, 16px horizontal padding, 48px touch targets)" },
    "md": { "value": "768px", "description": "Tablets & clinical iPads (2-column grids, 24px horizontal padding, collapsible drawer)" },
    "lg": { "value": "1024px", "description": "Desktop clinical workstations (3-column grids, persistent top navbar, 12-column layout)" },
    "xl": { "value": "1440px", "description": "Widescreen hospital displays (max-width 1280px container with generous outer whitespace)" }
  },
  "colors": {
    "light": {
      "bg": {
        "canvas": "#FFFFFF",
        "surface": "#F8FAFC",
        "mint": "#E8F5F2",
        "glass": "rgba(255, 255, 255, 0.84)"
      },
      "text": {
        "primary": "#0F172A",
        "secondary": "#334155",
        "muted": "#64748B",
        "onBrand": "#FFFFFF"
      },
      "brand": {
        "primary": "#087F8C",
        "primaryHover": "#066670",
        "primaryActive": "#05525A",
        "accentMint": "#E8F5F2",
        "accentBorder": "rgba(8, 127, 140, 0.22)"
      },
      "semantic": {
        "successBg": "#ECFDF5",
        "successText": "#065F46",
        "warningBg": "#FFFBEB",
        "warningText": "#92400E",
        "dangerBg": "#FFF1F2",
        "dangerText": "#9F1239",
        "quorumBg": "#F0FDFA",
        "quorumText": "#0F766E"
      },
      "border": {
        "subtle": "#F1F5F9",
        "default": "#E2E8F0",
        "focus": "#087F8C"
      }
    },
    "dark": {
      "bg": {
        "canvas": "#0B1120",
        "surface": "#111827",
        "mint": "rgba(20, 184, 166, 0.12)",
        "glass": "rgba(15, 23, 42, 0.82)"
      },
      "text": {
        "primary": "#F8FAFC",
        "secondary": "#CBD5E1",
        "muted": "#94A3B8",
        "onBrand": "#042F2E"
      },
      "brand": {
        "primary": "#2DD4BF",
        "primaryHover": "#14B8A6",
        "primaryActive": "#0D9488",
        "accentMint": "rgba(45, 212, 191, 0.14)",
        "accentBorder": "rgba(45, 212, 191, 0.28)"
      },
      "semantic": {
        "successBg": "rgba(16, 185, 129, 0.15)",
        "successText": "#6EE7B7",
        "warningBg": "rgba(245, 158, 11, 0.15)",
        "warningText": "#FCD34D",
        "dangerBg": "rgba(244, 63, 94, 0.15)",
        "dangerText": "#FDA4AF",
        "quorumBg": "rgba(45, 212, 191, 0.15)",
        "quorumText": "#5EEAD4"
      },
      "border": {
        "subtle": "#1E293B",
        "default": "#334155",
        "focus": "#2DD4BF"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "scale": {
      "display": { "fontSize": "2.75rem", "lineHeight": "1.15", "fontWeight": "700", "letterSpacing": "-0.025em" },
      "h1": { "fontSize": "2.25rem", "lineHeight": "1.2", "fontWeight": "700", "letterSpacing": "-0.02em" },
      "h2": { "fontSize": "1.75rem", "lineHeight": "1.25", "fontWeight": "700", "letterSpacing": "-0.015em" },
      "h3": { "fontSize": "1.25rem", "lineHeight": "1.35", "fontWeight": "600", "letterSpacing": "-0.01em" },
      "bodyLg": { "fontSize": "1.0625rem", "lineHeight": "1.65", "fontWeight": "400" },
      "body": { "fontSize": "0.9375rem", "lineHeight": "1.6", "fontWeight": "400" },
      "caption": { "fontSize": "0.75rem", "lineHeight": "1.45", "fontWeight": "500" },
      "overline": { "fontSize": "0.6875rem", "lineHeight": "1.4", "fontWeight": "700", "letterSpacing": "0.08em" }
    }
  },
  "spacing": {
    "unit": "4px",
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "5rem"
  },
  "borderRadius": {
    "sm": "0.5rem",
    "md": "0.75rem",
    "lg": "1rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "pill": "9999px"
  },
  "shadows": {
    "xs": "0 1px 2px 0 rgba(15, 23, 42, 0.04)",
    "card": "0 4px 16px -4px rgba(15, 23, 42, 0.06)",
    "hover": "0 12px 28px -8px rgba(8, 127, 140, 0.14)",
    "modal": "0 24px 48px -12px rgba(15, 23, 42, 0.18)"
  },
  "transitions": {
    "micro": { "duration": "150ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)", "usage": "Button press, focus ring, icon rotation" },
    "surface": { "duration": "250ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "usage": "Card hover elevation, filter pill switch, theme toggle" },
    "entrance": { "duration": "420ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "usage": "Modal dialog entrance, skeleton-to-content reveal" }
  }
}
